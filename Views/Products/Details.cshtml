@using WebUITopic5_Team4.Models.ViewModels
@model WebUITopic5_Team4.Models.Product

@{
    ViewData["Title"] = Model.ProductName;
    var breadcrumb = new BreadcrumbViewModel
    {
        Title = "Chi tiết sản phẩm",
        Items = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Trang chủ", Url.Action("Index", "Home")),
            new BreadcrumbItem("Sản phẩm", Url.Action("Index", "Products", new { categoryId = Model.CategoryId })),
            new BreadcrumbItem(Model.ProductName)
        }
    };
    
    // Lấy ảnh
    var primaryImage = Model.ImageUrl ?? "~/images/Others/product-1.jpg";
    
    var finalPrice = Model.UnitPrice;
}
@await Component.InvokeAsync("HeroSection")

<!-- Breadcrumb Section Begin -->
<partial name="_Breadcrumb" model="breadcrumb" />
<!-- Breadcrumb Section End -->

<!-- Product Details Section Begin -->
<section class="product-details spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6">
                <div class="product__details__pic @(Model.StockQuantity <= 0 ? "is-sold-out" : "")">
                    <div class="product__details__pic__item">
                        @if (Model.StockQuantity <= 0)
                        {
                            <div class="sold-out-overlay">
                                <span class="sold-out-text">Hết hàng</span>
                            </div>
                        }
                        <img class="product__details__pic__item--large product__details__main-img"
                             src="@Url.Content(primaryImage)" alt="@Model.ProductName">
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <div class="product__details__text">
                    <h3>@Model.ProductName</h3>
                    
                    <div class="product__details__price">@Model.UnitPrice.ToString("N0")₫</div>
                    
                    <p>
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả cho sản phẩm này." : Model.Description)
                    </p>
                    <div class="product__details__quantity">
                        <div class="quantity">
                            <div class="pro-qty @(Model.StockQuantity <= 0 ? "qty-disabled" : "")" data-max-stock="@Model.StockQuantity">
                                <input type="text" value="@(Model.StockQuantity > 0 ? "1" : "0")" id="productQuantity" readonly>
                            </div>
                        </div>
                    </div>
                    @if (Model.StockQuantity > 0)
                    {
                        <a href="#" class="primary-btn add-to-cart" data-product-id="@Model.ProductId">THÊM VÀO GIỎ</a>
                    }
                    else
                    {
                        <a href="javascript:void(0)" class="primary-btn btn-disabled" style="cursor: not-allowed;">HẾT HÀNG</a>
                    }
                    <ul>
                        <li><b>Tình trạng</b> <span class="@(Model.StockQuantity > 0 ? "text-success" : "text-danger")">@(Model.StockQuantity > 0 ? $"Còn hàng ({Model.StockQuantity})" : "Hết hàng")</span></li>
                        <li><b>Danh mục</b> <span>@Model.Category?.CategoryName</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Product Details Section End -->

<!-- Related Product Section Begin -->
@if (ViewBag.RelatedProducts != null && ViewBag.RelatedProducts.Count > 0)
{
    <section class="related-product">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title related__product__title">
                        <h2>Sản phẩm liên quan</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                @foreach (var item in (IEnumerable<WebUITopic5_Team4.Models.ViewModels.ProductCardViewModel>)ViewBag.RelatedProducts)
                {
                    <partial name="_ProductCard" model="item" view-data='new ViewDataDictionary(ViewData) { { "ColClass", "col-lg-3 col-md-4 col-sm-6" } }' />
                }
            </div>
        </div>
    </section>
}
<!-- Related Product Section End -->
